{
  "policy_id": "manjaro-lab-baseline",
  "description": "Política de exemplo para testes locais; não aplicada ao sistema.",
  "input_policy": "drop",
  "output_policy": "accept",
  "rules": [
    {
      "id": "allow-loopback",
      "chain": "input",
      "action": "accept",
      "protocol": "any",
      "source": "127.0.0.0/8",
      "destination_port": null,
      "service": "loopback",
      "description": "Permitir tráfego local de loopback."
    },
    {
      "id": "allow-established",
      "chain": "input",
      "action": "accept",
      "protocol": "any",
      "source": "any",
      "destination_port": null,
      "service": "established_related",
      "description": "Permitir tráfego de ligações já estabelecidas ou relacionadas."
    },
    {
      "id": "allow-ssh-lab",
      "chain": "input",
      "action": "accept",
      "protocol": "tcp",
      "source": "192.0.2.10/32",
      "destination_port": 22,
      "service": "ssh",
      "description": "Exemplo documental: SSH apenas a partir de um endereço de laboratório."
    }
  ]
}
